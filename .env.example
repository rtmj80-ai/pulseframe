# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# YOUTUBE_API_KEY: Used by /api/youtube.ts via X-goog-api-key header
# for YouTube Data API v3 (videos, channels, playlistItems, commentThreads, search).
YOUTUBE_API_KEY=""

# GOOGLE_API_KEY: Optional fallback key for Google Books v1 and Webfonts v1 APIs via X-goog-api-key header.
GOOGLE_API_KEY=""

# SORA_API_KEY: Used by /api/sora.ts serverless endpoint (set manually in environment).
SORA_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""
